# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Dependency directories
vendor/

# Go workspace file
# go.work is tracked in this project

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local

# Build artifacts
dist/
bin/

# Linked git worktrees (project-local, per rpg-api/rpg-dnd5e-web convention)
.worktrees/
# Agent tooling scratch. These directories hold subagent transcripts, prompts and
# metadata — working state, not source. They appear wherever an agent is run, not
# only at the repo root, so this is deliberately unanchored: a nested one inside
# a module was swept into a PR by `git add -A <dir>` and had to be removed.
.pi-subagents/
.pi/agents/
